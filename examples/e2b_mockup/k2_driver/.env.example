# K2 API Configuration

# K2 API base URL (without trailing slash)
K2_API_URL=http://localhost:8000

# K2 authentication credentials
K2_USERNAME=demo
K2_PASSWORD=demo

# Company identifier in K2 system
K2_COMPANY_ID=demo

# Optional: Request timeout in seconds
K2_TIMEOUT=30

# Optional: Enable debug logging
K2_DEBUG=false
